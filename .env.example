DATABASE_URL="postgresql://entertabcrm:entertabcrm@localhost:5432/entertabcrm_auth?schema=public"
JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret"
GOOGLE_CLIENT_ID="replace-later"
APP_URL="http://localhost:3001"

INTERNAL_JOB_TOKEN="replace-with-a-long-random-token-for-scheduler-jobs"

# Private durable volume shared by API and worker processes.
FILE_OBJECT_ROOT=".local-file-objects"
# Trusted scanner and preview/text processing service; required for upload completion.
# HTTPS required outside loopback development. See src/server/collab/files/FILES.md.
FILE_PROCESSOR_URL=""
FILE_PROCESSOR_TOKEN=""
# At least 32 bytes; identical on every API process. Rotation invalidates outstanding two-minute grants.
FILE_DELIVERY_SECRET=""

# Authenticated broker for vendor document editor sessions. INTERNAL_DOCS text editing works locally.
FILE_EDITOR_URL=
FILE_EDITOR_TOKEN=

# Trusted Integration broker owns Google/Microsoft OAuth credentials and vendor APIs.
# HTTPS required outside loopback development. See src/server/collab/calendar/SYNC.md.
CALENDAR_SYNC_BROKER_URL=""
CALENDAR_SYNC_BROKER_TOKEN=""

# --- Business suite: Online Store, Marketing, HR & Time, Sites ---------------------------------
# Encryption key for sealed suite data (destinations, private HR fields, tokens). Required in production;
# falls back to a key derived from JWT_ACCESS_SECRET in development only. Rotate with re-encryption.
SUITE_DATA_KEY=""
# Absolute public base URL used in unsubscribe/tracking links sent to recipients.
PUBLIC_BASE_URL="http://localhost:3000"
# Customer (storefront) notification provider key recorded on provider calls; delivery adapter is external.
CUSTOMER_MAIL_PROVIDER="SANDBOX"
# Marketing provider credentials are referenced by connections as `env:NAME` secret refs, e.g.:
#   SMTP:  "host:port:username:password" (implicit TLS)   SES: "region:accessKeyId:secretAccessKey"
#   TWILIO: "accountSid:authToken"   META_WHATSAPP: "phoneNumberId:accessToken"   META ads: "adAccountId:accessToken"
# Webhook signing secrets are referenced the same way (connection.webhookSecretRef).
# MARKETING_SMTP_MAIN=""
# MARKETING_WEBHOOK_SECRET=""
# Sites hosting: managed subdomain zone, DNS-over-HTTPS resolver for TXT verification, TLS issuer.
SITES_PLATFORM_DOMAIN="sites.truecrm.app"
SITES_DOH_RESOLVER="https://cloudflare-dns.com/dns-query"
SITES_TLS_PROVIDER=""
# Shared AI gateway used by Sites AI drafts/translations (no second model backend is embedded).
AI_GATEWAY_URL=""
AI_GATEWAY_SECRET_REF=""

# ---- Final pack: Platform Services ----
# Deployment environment name used by readiness/restore guards (development | staging | production).
APP_ENV="development"
# HMAC secret used to verify platform step-up MFA assertions (x-mfa-assertion). Step-up fails closed when unset.
PLATFORM_MFA_VERIFIER_SECRET=""
# Signing secret for short-lived realtime/presence tokens.
REALTIME_TOKEN_SECRET=""
# Notification delivery providers (SANDBOX records deliveries without sending) and the provider callback signing secret.
NOTIFICATION_EMAIL_PROVIDER="SANDBOX"
NOTIFICATION_PUSH_PROVIDER="SANDBOX"
NOTIFICATION_WEBHOOK_SECRET=""
# Isolated restore-test runner (never production) and the comma-separated environments it may target.
RESTORE_TEST_RUNNER_URL=""
RESTORE_TEST_RUNNER_TOKEN=""
RESTORE_TEST_ENVIRONMENTS="staging-restore"

# ---- Final pack: Subscription Billing ----
# Payment provider checked by production readiness (STRIPE | XPAY | SANDBOX).
BILLING_PAYMENT_PROVIDER="SANDBOX"
# Stripe (or other) provider credentials; webhooks arrive at /api/v1/webhooks/billing/:provider and are signature-verified.
BILLING_STRIPE_SECRET_KEY=""
BILLING_STRIPE_WEBHOOK_SECRET=""
BILLING_STRIPE_ACCOUNT_ID=""
BILLING_XPAY_API_BASE=""
BILLING_XPAY_SECRET_KEY=""
BILLING_XPAY_WEBHOOK_SECRET=""
BILLING_XPAY_ACCOUNT_ID=""
BILLING_XPAY_RETURN_URL=""
# Deterministic SANDBOX payment provider signing secret (non-production only).
BILLING_SANDBOX_SECRET=""
BILLING_REPORTING_CURRENCY="USD"

# ---- Final pack: Partner Program ----
PARTNER_TERMS_VERSION="2026-10"
PARTNER_PRIVACY_VERSION="2026-10"
PARTNER_MAX_ATTRIBUTION_DAYS="90"
PARTNER_ACCESS_MAX_DAYS="30"

# ---- Final pack: Knowledge Base ----
# Signing secret for article-scoped guest sessions; guest invitations and reads fail when unset.
KNOWLEDGE_GUEST_SECRET=""
KNOWLEDGE_GUEST_MAX_DAYS="30"
KNOWLEDGE_READ_DEDUPE_HOURS="24"

# ---- Final pack: AI CoPilot ----
# Platform provider connections reference vault secrets as env:NAME (e.g. env:AI_OPENAI_KEY); BYOK keys are sealed with SUITE_DATA_KEY.
# AI_OPENAI_KEY=""
# Enables the deterministic SANDBOX model provider (refused in production).
AI_SANDBOX_ENABLED="false"
AI_PROVIDER_TIMEOUT_MS="60000"
# Credits charged per unit of provider cost currency.
AI_CREDITS_PER_CURRENCY_UNIT="1000"
AZURE_OPENAI_API_VERSION="2024-10-21"
AI_TRANSCRIBE_MODEL="whisper-1"
AI_IMAGE_MODEL="gpt-image-1"

# Explicit exclusive tax rates approved for each payer country. No production fallback.
# Example schema only (supply approved rates): {"version":"approved-policy-id","countries":{"XX":{"rateBasisPoints":0,"taxCode":"approved-code"}}}
BILLING_TAX_POLICY_JSON=""
# Reuse the SES/SMTP provider adapter via a vault reference (env:VARIABLE).
NOTIFICATION_EMAIL_SECRET_REF=""
NOTIFICATION_EMAIL_FROM=""

DATABASE_URL="postgresql://entertabcrm:entertabcrm@localhost:5432/entertabcrm_auth?schema=public"
JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret"
GOOGLE_CLIENT_ID="replace-later"
APP_URL="http://localhost:3001"

INTERNAL_JOB_TOKEN="replace-with-a-long-random-token-for-scheduler-jobs"

# Private durable volume shared by API and worker processes.
FILE_OBJECT_ROOT=".local-file-objects"
# Trusted scanner and preview/text processing service; required for upload completion.
# HTTPS required outside loopback development. See src/server/collab/files/FILES.md.
FILE_PROCESSOR_URL=""
FILE_PROCESSOR_TOKEN=""
# At least 32 bytes; identical on every API process. Rotation invalidates outstanding two-minute grants.
FILE_DELIVERY_SECRET=""

# Authenticated broker for vendor document editor sessions. INTERNAL_DOCS text editing works locally.
FILE_EDITOR_URL=
FILE_EDITOR_TOKEN=

# Trusted Integration broker owns Google/Microsoft OAuth credentials and vendor APIs.
# HTTPS required outside loopback development. See src/server/collab/calendar/SYNC.md.
CALENDAR_SYNC_BROKER_URL=""
CALENDAR_SYNC_BROKER_TOKEN=""

# --- Business suite: Online Store, Marketing, HR & Time, Sites ---------------------------------
# Encryption key for sealed suite data (destinations, private HR fields, tokens). Required in production;
# falls back to a key derived from JWT_ACCESS_SECRET in development only. Rotate with re-encryption.
SUITE_DATA_KEY=""
# Absolute public base URL used in unsubscribe/tracking links sent to recipients.
PUBLIC_BASE_URL="http://localhost:3000"
# Customer (storefront) notification provider key recorded on provider calls; delivery adapter is external.
CUSTOMER_MAIL_PROVIDER="SANDBOX"
# Marketing provider credentials are referenced by connections as `env:NAME` secret refs, e.g.:
#   SMTP:  "host:port:username:password" (implicit TLS)   SES: "region:accessKeyId:secretAccessKey"
#   TWILIO: "accountSid:authToken"   META_WHATSAPP: "phoneNumberId:accessToken"   META ads: "adAccountId:accessToken"
# Webhook signing secrets are referenced the same way (connection.webhookSecretRef).
# MARKETING_SMTP_MAIN=""
# MARKETING_WEBHOOK_SECRET=""
# Sites hosting: managed subdomain zone, DNS-over-HTTPS resolver for TXT verification, TLS issuer.
SITES_PLATFORM_DOMAIN="sites.truecrm.app"
SITES_DOH_RESOLVER="https://cloudflare-dns.com/dns-query"
SITES_TLS_PROVIDER=""
# Shared AI gateway used by Sites AI drafts/translations (no second model backend is embedded).
AI_GATEWAY_URL=""
AI_GATEWAY_SECRET_REF=""

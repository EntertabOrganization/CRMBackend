generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Core IAM Models ---

model Company {
  id              String    @id @default(uuid())
  name            String    @unique
  companyCategory String
  description     String?
  ownerId         String?   @unique
  owner           User?     @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  isDeleted       Boolean   @default(false) @map("is_deleted")
  deletedAt       DateTime?

  users User[]
  roles Role[]

  @@index([ownerId])
  @@map("companies")
}

model User {
  id          String    @id @default(uuid())
  firstName   String
  lastName    String
  email       String    @unique
  password    String
  companyId   String?
  company     Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ownedCompany Company? @relation("CompanyOwner")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  isDeleted   Boolean   @default(false) @map("is_deleted")
  deletedAt   DateTime?

  roles UserRole[]

  @@index([companyId])
  @@map("users")
}

model Role {
  id          String    @id @default(uuid())
  name        String
  description String?
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  isDeleted   Boolean   @default(false) @map("is_deleted")
  deletedAt   DateTime?

  permissions RolePermission[]
  users       UserRole[]

  @@index([companyId])
  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  slug        String  @unique
  name        String
  description String?
  module      String
  isDeleted   Boolean @default(false) @map("is_deleted")

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  isDeleted    Boolean    @default(false) @map("is_deleted")

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId    String
  roleId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  isDeleted Boolean @default(false) @map("is_deleted")

  @@id([userId, roleId])
  @@map("user_roles")
}

// --- Required Enums ---

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

enum PaymentProvider {
  STRIPE
  PAYPAL
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum ResourceType {
  DOCUMENT
  MEDIA
  CODE
}

  leaseExpiresAt     DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  errorCode          String?   @map("error_code")
  correlationId      String    @default(uuid()) @map("correlation_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status, createdAt])
  @@map("spa_purge_jobs")
}

model WorkflowDefinition {
  id                   String   @id @default(uuid()) @db.Uuid
  workspaceId          String   @map("workspace_id") @db.Uuid
  code                 String
  name                 String
  type                 String
  status               String   @default("DRAFT")
  boundEntityType      String   @map("bound_entity_type")
  boundEntityTypeId    String?  @map("bound_entity_type_id") @db.Uuid
  currentVersionId     String?  @map("current_version_id") @db.Uuid
  concurrencyMode      String   @default("ONE_PER_DEFINITION_PER_ENTITY") @map("concurrency_mode")
  runAs                String   @default("STARTER") @map("run_as")
  serviceAccountUserId String?  @map("service_account_user_id") @db.Uuid
  version              Int      @default(1)
  createdByUserId      String   @map("created_by_user_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([workspaceId, id])
  @@unique([workspaceId, code])
  @@index([workspaceId, status, boundEntityType])
  @@map("workflow_definitions")
}


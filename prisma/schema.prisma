model CalendarEvent {
  id                      String                        @id @db.Uuid
  workspaceId             String                        @map("workspace_id") @db.Uuid
  calendarId              String                        @map("calendar_id") @db.Uuid
  organizerUserId         String                        @map("organizer_user_id") @db.Uuid
  title                   String
  description             String?
  location                String?
  isAllDay                Boolean                       @default(false) @map("is_all_day")
  startAt                 DateTime?                     @map("start_at") @db.Timestamptz(6)
  endAt                   DateTime?                     @map("end_at") @db.Timestamptz(6)
  startDate               DateTime?                     @map("start_date") @db.Date
  endDate                 DateTime?                     @map("end_date") @db.Date
  sourceTimezone          String                        @map("source_timezone")
  status                  CalendarEventStatus           @default(CONFIRMED)
  busyStatus              CalendarBusyStatus            @default(BUSY) @map("busy_status")
  recurrenceRuleId        String?                       @map("recurrence_rule_id") @db.Uuid
  recurrenceParentEventId String?                       @map("recurrence_parent_event_id") @db.Uuid
  recurrenceIdentity      String?                       @map("recurrence_identity")
  statusBeforeCancel      CalendarEventStatus?          @map("status_before_cancel")
  cancelledAt             DateTime?                     @map("cancelled_at") @db.Timestamptz(6)
  isDeleted               Boolean                       @default(false) @map("is_deleted")
  deletedAt               DateTime?                     @map("deleted_at") @db.Timestamptz(6)
  version                 Int                           @default(1)
  createdAt               DateTime                      @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                      @map("updated_at") @db.Timestamptz(6)
  calendar                Calendar                      @relation(fields: [workspaceId, calendarId], references: [workspaceId, id], onDelete: NoAction)
  organizer               User                          @relation(fields: [organizerUserId], references: [id], onDelete: NoAction)
  attendees               CalendarEventAttendee[]
  guests                  CalendarExternalGuest[]
  bindings                CalendarEventBinding[]
  files                   CalendarEventFile[]
  history                 CalendarEventHistory[]
  meetingRecord           MeetingRecord?
  decisions               MeetingDecision[]
  recurrenceRules         CalendarRecurrenceRule[]
  activeRecurrence        CalendarRecurrenceRule?       @relation("ActiveRecurrence", fields: [workspaceId, id, recurrenceRuleId], references: [workspaceId, eventId, id], onDelete: NoAction)
  recurrenceParent        CalendarEvent?                @relation("OccurrenceParent", fields: [workspaceId, recurrenceParentEventId], references: [workspaceId, id], onDelete: NoAction)
  recurrenceOverrides     CalendarEvent[]               @relation("OccurrenceParent")
  recurrenceExceptions    CalendarRecurrenceException[]
  reminders               CalendarEventReminder[]
  resourceBookings        CalendarResourceBooking[]

  @@unique([workspaceId, id])
  @@index([workspaceId, calendarId, startAt])
  @@index([workspaceId, calendarId, startDate])
  @@index([workspaceId, organizerUserId, status, isDeleted])
  @@map("calendar_events")
}


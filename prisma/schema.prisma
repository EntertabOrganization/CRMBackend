  PENDING
  RUNNING
  SUCCEEDED
  SUCCEEDED_WITH_ERRORS
  FAILED_RETRYABLE
  FAILED_FINAL
  SKIPPED_CONDITION
  SKIPPED_STALE
  CANCELLED
}


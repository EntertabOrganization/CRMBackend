  totals            Json      @default("{}") @map("totals_json")
  errorCode         String?   @map("error_code")
  reportFileId      String?   @map("report_file_id") @db.Uuid
  claimToken        String?   @map("claim_token") @db.Uuid
  leaseExpiresAt    DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  attempts          Int       @default(0)
  nextAttemptAt     DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  correlationId     String    @default(uuid()) @map("correlation_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([workspaceId, id])
  @@index([status, nextAttemptAt])
  @@map("spa_import_jobs")
}

model SpaImportRow {
  id             String  @id @default(uuid()) @db.Uuid
  workspaceId    String  @map("workspace_id") @db.Uuid
  jobId          String  @map("job_id") @db.Uuid
  rowNumber      Int     @map("row_number")
  externalSource String? @map("external_source")
  externalId     String? @map("external_id")
  status         String
  errorCodes     Json    @default("[]") @map("error_codes_json")
  itemId         String? @map("item_id") @db.Uuid

  @@unique([workspaceId, jobId, rowNumber])
  @@map("spa_import_rows")
}

model SpaItemExternalKey {
  id           String    @id @default(uuid()) @db.Uuid
  workspaceId  String    @map("workspace_id") @db.Uuid
  typeId       String    @map("type_id") @db.Uuid

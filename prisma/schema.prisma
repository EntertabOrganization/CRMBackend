  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([workspaceId, id])
  @@unique([workspaceId, sourceItemId, definitionId, targetType, targetId])
  @@index([workspaceId, targetType, targetId])
  @@map("spa_item_relations")
}

model SpaUserViewPreference {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  typeId      String @map("type_id") @db.Uuid
  userId      String @map("user_id") @db.Uuid
  viewType    String @map("view_type")
  preferences Json
  version     Int    @default(1)

  @@unique([workspaceId, typeId, userId, viewType])
  @@map("spa_user_view_preferences")
}

model SpaImportJob {
  id                String    @id @default(uuid()) @db.Uuid
  workspaceId       String    @map("workspace_id") @db.Uuid
  typeId            String    @map("type_id") @db.Uuid
  mode              String
  mapping           Json      @map("mapping_json")
  sourceFileId      String    @map("source_file_id") @db.Uuid
  sourceSystem      String?   @map("source_system")
  externalKeyColumn String?   @map("external_key_column")
  sourceVersionId   String?   @map("source_version_id") @db.Uuid
  createdByUserId   String    @map("created_by_user_id") @db.Uuid
  status            String    @default("QUEUED")

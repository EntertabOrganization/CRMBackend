}

/// Version + totals of one owner's row set (optimistic concurrency for atomic replace).
model CommercialRowSet {
  id              String   @id @default(uuid()) @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  ownerType       String   @map("owner_type")
  ownerId         String   @map("owner_id") @db.Uuid
  version         Int      @default(1)
  currency        String?
  subtotal        Decimal  @default(0) @db.Decimal(28, 8)
  taxTotal        Decimal  @default(0) @map("tax_total") @db.Decimal(28, 8)
  total           Decimal  @default(0) @db.Decimal(28, 8)
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([workspaceId, ownerType, ownerId])
  @@map("commercial_row_sets")
}

/// Durable aggregate storage for the Commercial/Capture/Contact-Center bounded contexts.
/// The domain services expose typed entities; JSON allows this repository's state-snapshot persistence layer
/// to commit a large connected aggregate atomically while dedicated indexes enforce tenant/collection access.
model CommercialPackRecord {
  id          String   @id @db.Uuid
  workspaceId String?  @map("workspace_id") @db.Uuid
  collection  String
  data        Json
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, collection])
  @@index([collection])
  @@map("commercial_pack_records")
}

// ---------------------------------------------------------------------------
// Tasks & Projects (TrueCRM Collaboration Pack)
// Child rows reference parents through (workspace_id, parent_id) composite keys, so a row can never point at a
// parent in another Workspace. Version columns are guarded by a trigger (see migration) as a cross-instance backstop.
// ---------------------------------------------------------------------------

enum ProjectType {
  PROJECT
  WORKGROUP
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum ProjectVisibility {
  PRIVATE
  WORKSPACE_VISIBLE
  OPEN
  INVITE_ONLY
}

enum ProjectRole {
  OWNER
  MODERATOR
  MEMBER
}

enum ProjectMemberStatus {
  ACTIVE

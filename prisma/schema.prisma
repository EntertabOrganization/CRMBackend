}

model WorkflowRuntimePolicy {
  id                      String @id @default(uuid()) @db.Uuid
  workspaceId             String @unique @map("workspace_id") @db.Uuid
  maxLoopIterations       Int    @default(1000) @map("max_loop_iterations")
  maxNodeRuns             Int    @default(10000) @map("max_node_runs")
  maxDepth                Int    @default(10) @map("max_depth")
  maxLifetimeDays         Int    @default(365) @map("max_lifetime_days")
  maxConcurrentExecutions Int    @default(100) @map("max_concurrent_executions")
  retentionDays           Int    @default(365) @map("retention_days")
  version                 Int    @default(1)

  @@map("workflow_runtime_policies")
}

model WorkflowExecution {
  id                String    @id @default(uuid()) @db.Uuid
  workspaceId       String    @map("workspace_id") @db.Uuid
  definitionId      String    @map("definition_id") @db.Uuid
  versionId         String    @map("version_id") @db.Uuid
  snapshot          Json
  entityType        String    @map("entity_type")
  entityId          String    @map("entity_id") @db.Uuid
  runAs             String    @map("run_as")
  concurrencyMode   String    @map("concurrency_mode")
  concurrencyKey    String?   @map("concurrency_key")
  executionUserId   String    @map("execution_user_id") @db.Uuid
  startedByType     String    @default("USER") @map("started_by_type")
  startedByUserId   String    @map("started_by_id") @db.Uuid
  parameters        Json
  variables         Json      @default("{}")
  status            String    @default("QUEUED")
  resultCode        String?   @map("result_code")
  result            Json?     @map("result_json")
  parentExecutionId String?   @map("parent_execution_id") @db.Uuid
  depth             Int       @default(0)
  ancestry          Json      @default("[]")

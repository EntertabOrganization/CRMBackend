generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SpaEntityType {
  id              String    @id @default(uuid()) @db.Uuid
  workspaceId     String    @map("workspace_id") @db.Uuid
  code            String
  name            String
  pluralName      String    @map("plural_name")
  description     String?
  placement       String
  status          String    @default("DRAFT")
  schemaVersion   Int       @default(0) @map("schema_version")
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  version         Int       @default(1)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@unique([workspaceId, id])
  @@unique([workspaceId, code])
  @@index([workspaceId, status, placement])
  @@map("spa_entity_types")
}

model SpaCapability {
  id            String  @id @default(uuid()) @db.Uuid
  workspaceId   String  @map("workspace_id") @db.Uuid
  typeId        String  @map("type_id") @db.Uuid
  key           String  @map("capability_key")
  enabled       Boolean
  configuration Json    @default("{}")

  @@unique([workspaceId, typeId, key])
  @@map("spa_capabilities")
}

model SpaSchemaDraft {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  typeId      String   @map("type_id") @db.Uuid
  version     Int      @default(1)
  snapshot    Json     @default("{}")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([workspaceId, typeId])
  @@unique([workspaceId, id])
  @@map("spa_schema_drafts")
}

model SpaSchemaVersion {
  id            String   @id @default(uuid()) @db.Uuid
  workspaceId   String   @map("workspace_id") @db.Uuid
  typeId        String   @map("type_id") @db.Uuid
  versionNumber Int      @map("version_number")
  snapshot      Json
  checksum      String
  publishedBy   String   @map("published_by") @db.Uuid
  publishedAt   DateTime @default(now()) @map("published_at") @db.Timestamptz(6)

  @@unique([workspaceId, typeId, versionNumber])
  @@unique([workspaceId, id])
  @@map("spa_schema_versions")
}

model SpaFieldDefinition {
  id           String  @id @default(uuid()) @db.Uuid
  workspaceId  String  @map("workspace_id") @db.Uuid
  typeId       String  @map("type_id") @db.Uuid
  code         String
  name         String
  fieldType    String  @map("field_type")
  isRequired   Boolean @default(false) @map("is_required")
  isMultiple   Boolean @default(false) @map("is_multiple")
  isActive     Boolean @default(true) @map("is_active")
  isSearchable Boolean @default(false) @map("is_searchable")
  defaultValue Json?   @map("default_json")
  validation   Json    @default("{}")
  visibility   Json    @default("{}")
  options      Json    @default("[]")
  version      Int     @default(1)

  @@unique([workspaceId, id])
  @@unique([workspaceId, typeId, code])
  @@map("spa_field_definitions")
}

model SpaPipeline {
  id          String  @id @default(uuid()) @db.Uuid
  workspaceId String  @map("workspace_id") @db.Uuid
  typeId      String  @map("type_id") @db.Uuid
  code        String
  name        String
  isDefault   Boolean @default(false) @map("is_default")
  sortOrder   Int     @default(0) @map("sort_order")
  status      String  @default("ACTIVE")
  version     Int     @default(1)

  @@unique([workspaceId, id])
  @@unique([workspaceId, typeId, code])
  @@map("spa_pipelines")
}

model SpaStage {
  id              String  @id @default(uuid()) @db.Uuid
  workspaceId     String  @map("workspace_id") @db.Uuid
  pipelineId      String  @map("pipeline_id") @db.Uuid
  code            String
  name            String
  semantic        String  @default("PROGRESS")
  isDefault       Boolean @default(false) @map("is_default")
  sortOrder       Int     @default(0) @map("sort_order")
  status          String  @default("ACTIVE")
  requirements    Json    @default("[]")
  transitionRules Json    @default("[]") @map("transition_rules")
  version         Int     @default(1)

  @@unique([workspaceId, id])
  @@unique([workspaceId, pipelineId, code])
  @@unique([workspaceId, pipelineId, id])
  @@map("spa_stages")
}

model SpaItem {
  id              String    @id @default(uuid()) @db.Uuid
  workspaceId     String    @map("workspace_id") @db.Uuid
  typeId          String    @map("type_id") @db.Uuid
  itemNumber      String    @map("item_number")
  title           String
  assignedUserId  String    @map("assigned_user_id") @db.Uuid
  companyId       String?   @map("company_id") @db.Uuid
  pipelineId      String?   @map("pipeline_id") @db.Uuid
  stageId         String?   @map("stage_id") @db.Uuid
  status          String    @default("ACTIVE")
  version         Int       @default(1)
  schemaVersion   Int       @map("schema_version")
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  updatedByUserId String    @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  trashedAt       DateTime? @map("trashed_at") @db.Timestamptz(6)
  purgeAfter      DateTime? @map("purge_after") @db.Timestamptz(6)
  closedAt        DateTime? @map("closed_at") @db.Timestamptz(6)
  legalHold       Boolean   @default(false) @map("legal_hold")

  @@unique([workspaceId, id])
  @@unique([workspaceId, typeId, itemNumber])
  @@index([workspaceId, typeId, status, assignedUserId])
  @@map("spa_items")
}

model SpaItemValue {
  id            String    @id @default(uuid()) @db.Uuid
  workspaceId   String    @map("workspace_id") @db.Uuid
  itemId        String    @map("item_id") @db.Uuid
  fieldId       String    @map("field_id") @db.Uuid
  valueText     String?   @map("value_text")
  valueNumber   Decimal?  @map("value_number") @db.Decimal(24, 6)
  valueDate     DateTime? @map("value_date") @db.Timestamptz(6)
  valueBoolean  Boolean?  @map("value_boolean")
  valueJson     Json?     @map("value_json")
  schemaVersion Int       @map("schema_version")

  @@unique([workspaceId, itemId, fieldId])
  @@map("spa_item_field_values")
}

model SpaItemObserver {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  itemId      String @map("item_id") @db.Uuid
  userId      String @map("user_id") @db.Uuid

  @@unique([workspaceId, itemId, userId])
  @@map("spa_item_observers")
}

model SpaItemContact {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  itemId      String @map("item_id") @db.Uuid
  contactId   String @map("contact_id") @db.Uuid

  @@unique([workspaceId, itemId, contactId])
  @@map("spa_item_contacts")
}

model SpaHistory {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  typeId      String   @map("type_id") @db.Uuid
  itemId      String?  @map("item_id") @db.Uuid
  actorUserId String   @map("actor_user_id") @db.Uuid
  action      String
  changes     Json
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([workspaceId, typeId, itemId, occurredAt])
  @@map("spa_history")
}

model SpaNumberingScheme {
  id             String @id @default(uuid()) @db.Uuid
  workspaceId    String @map("workspace_id") @db.Uuid
  typeId         String @map("type_id") @db.Uuid
  prefixTemplate String @map("prefix_template")
  padding        Int    @default(6)
  resetPolicy    String @default("NEVER") @map("reset_policy")
  version        Int    @default(1)

  @@unique([workspaceId, typeId])
  @@map("spa_numbering_schemes")
}

model SpaNumberingSequence {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  typeId      String @map("type_id") @db.Uuid
  periodKey   String @map("period_key")
  nextValue   BigInt @default(1) @map("next_value")

  @@unique([workspaceId, typeId, periodKey])
  @@map("spa_numbering_sequences")
}

model SpaSchemaMigrationJob {
  id                 String    @id @default(uuid()) @db.Uuid
  workspaceId        String    @map("workspace_id") @db.Uuid
  typeId             String    @map("type_id") @db.Uuid
  fieldId            String    @map("field_id") @db.Uuid
  oldVersion         Int       @map("old_version")
  draftId            String    @map("new_draft_id") @db.Uuid
  draftVersion       Int       @map("draft_version")
  targetType         String    @map("target_type")
  fieldMapping       Json      @map("field_mapping_json")
  conversionFailures Json      @default("[]") @map("conversion_failures")
  processedCount     Int       @default(0) @map("processed_count")
  status             String    @default("QUEUED")
  createdByUserId    String    @map("created_by_user_id") @db.Uuid
  claimToken         String?   @map("claim_token") @db.Uuid
  leaseExpiresAt     DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  correlationId      String    @default(uuid()) @map("correlation_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt        DateTime? @map("completed_at") @db.Timestamptz(6)
  appliedAt          DateTime? @map("applied_at") @db.Timestamptz(6)

  @@unique([workspaceId, id])
  @@index([status, createdAt])
  @@map("spa_schema_migration_jobs")
}

model SpaSchemaMigrationValue {
  id                String @id @default(uuid()) @db.Uuid
  workspaceId       String @map("workspace_id") @db.Uuid
  jobId             String @map("job_id") @db.Uuid
  itemId            String @map("item_id") @db.Uuid
  sourceHash        String @map("source_hash")
  sourceItemVersion Int    @map("source_item_version")
  originalValue     Json   @map("original_value")
  convertedValue    Json   @map("converted_value")

  @@unique([workspaceId, jobId, itemId])
  @@map("spa_schema_migration_values")
}

model SpaRecurrenceRule {
  id               String    @id @default(uuid()) @db.Uuid
  workspaceId      String    @map("workspace_id") @db.Uuid
  typeId           String    @map("type_id") @db.Uuid
  frequency        String
  timezone         String
  startsAt         DateTime  @map("starts_at") @db.Timestamptz(6)
  endsAt           DateTime? @map("ends_at") @db.Timestamptz(6)
  interval         Int       @default(1)
  byDay            Json      @default("[]") @map("by_day_json")
  maxInstances     Int?      @map("max_instances")
  customRule       String?   @map("custom_rule")
  templatePayload  Json      @map("item_payload_json")
  createdByUserId  String    @map("created_by_user_id") @db.Uuid
  isActive         Boolean   @default(true) @map("is_active")
  version          Int       @default(1)
  nextScheduledFor DateTime? @map("next_scheduled_for") @db.Timestamptz(6)
  nextRetryAt      DateTime? @map("next_retry_at") @db.Timestamptz(6)
  lastErrorCode    String?   @map("last_error_code")
  failureCount     Int       @default(0) @map("failure_count")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([workspaceId, id])
  @@index([isActive, nextScheduledFor])
  @@map("spa_recurrence_rules")
}

model SpaRecurrenceInstance {
  id           String   @id @default(uuid()) @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  ruleId       String   @map("rule_id") @db.Uuid
  scheduledFor DateTime @map("scheduled_for") @db.Timestamptz(6)
  itemId       String   @map("item_id") @db.Uuid
  ruleVersion  Int      @map("rule_version")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([workspaceId, ruleId, scheduledFor])
  @@map("spa_recurrence_instances")
}

model SpaItemRelation {
  id           String   @id @default(uuid()) @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  typeId       String   @map("type_id") @db.Uuid
  sourceItemId String   @map("source_item_id") @db.Uuid
  definitionId String   @map("relation_definition_id") @db.Uuid

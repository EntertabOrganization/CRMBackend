model TaskRecurrenceRule {
  id                String                   @id @db.Uuid
  workspaceId       String                   @map("workspace_id") @db.Uuid
  templateId        String                   @map("template_id") @db.Uuid
  frequency         RecurrenceFrequency
  intervalValue     Int                      @map("interval_value")

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SpaEntityType {
  id String @id @default(uuid()) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  code String
  name String
  pluralName String @map("plural_name")
  description String?
  placement String
  status String @default("DRAFT")
  schemaVersion Int @default(0) @map("schema_version")
  createdByUserId String @map("created_by_user_id") @db.Uuid
  version Int @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  @@unique([workspaceId, id])
  @@unique([workspaceId, code])
  @@index([workspaceId, status, placement])
  @@map("spa_entity_types")
}

model SpaCapability {
  id String @id @default(uuid()) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  typeId String @map("type_id") @db.Uuid
  key String @map("capability_key")
  enabled Boolean
  configuration Json @default("{}")
  @@unique([workspaceId, typeId, key])
  @@map("spa_capabilities")
}

model SpaSchemaDraft {
  id String @id @default(uuid()) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  typeId String @map("type_id") @db.Uuid
  version Int @default(1)
  snapshot Json @default("{}")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  @@unique([workspaceId, typeId])
  @@unique([workspaceId, id])
  @@map("spa_schema_drafts")
}

model SpaSchemaVersion {
  id String @id @default(uuid()) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  typeId String @map("type_id") @db.Uuid
  versionNumber Int @map("version_number")
  snapshot Json
  checksum String
  publishedBy String @map("published_by") @db.Uuid
  publishedAt DateTime @default(now()) @map("published_at") @db.Timestamptz(6)
  @@unique([workspaceId, typeId, versionNumber])
  @@unique([workspaceId, id])
  @@map("spa_schema_versions")
}

model SpaFieldDefinition {
  id String @id @default(uuid()) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  typeId String @map("type_id") @db.Uuid
  code String
  name String
  fieldType String @map("field_type")
  isRequired Boolean @default(false) @map("is_required")
  isMultiple Boolean @default(false) @map("is_multiple")
  isActive Boolean @default(true) @map("is_active")
  isSearchable Boolean @default(false) @map("is_searchable")
  defaultValue Json? @map("default_json")
  validation Json @default("{}")
  visibility Json @default("{}")
  options Json @default("[]")
  version Int @default(1)
  @@unique([workspaceId, id])
  @@unique([workspaceId, typeId, code])
  @@map("spa_field_definitions")
}

model SpaPipeline {
  id String @id @default(uuid()) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  typeId String @map("type_id") @db.Uuid
  code String
  name String
  isDefault Boolean @default(false) @map("is_default")
  sortOrder Int @default(0) @map("sort_order")
  status String @default("ACTIVE")
  version Int @default(1)
  @@unique([workspaceId, id])
  @@unique([workspaceId, typeId, code])
  @@map("spa_pipelines")
}

model SpaStage {
  id String @id @default(uuid()) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  pipelineId String @map("pipeline_id") @db.Uuid
  code String
  name String
  semantic String @default("PROGRESS")
  isDefault Boolean @default(false) @map("is_default")
  sortOrder Int @default(0) @map("sort_order")
  status String @default("ACTIVE")
  requirements Json @default("[]")
  transitionRules Json @default("[]") @map("transition_rules")
  version Int @default(1)
  @@unique([workspaceId, id])
  @@unique([workspaceId, pipelineId, code])
  @@unique([workspaceId, pipelineId, id])
  @@map("spa_stages")
}

model SpaItem {
  id String @id @default(uuid()) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  typeId String @map("type_id") @db.Uuid
  itemNumber String @map("item_number")
  title String
  assignedUserId String @map("assigned_user_id") @db.Uuid
  companyId String? @map("company_id") @db.Uuid
  pipelineId String? @map("pipeline_id") @db.Uuid
  stageId String? @map("stage_id") @db.Uuid
  status String @default("ACTIVE")
  version Int @default(1)
  schemaVersion Int @map("schema_version")
  createdByUserId String @map("created_by_user_id") @db.Uuid
  updatedByUserId String @map("updated_by_user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  trashedAt DateTime? @map("trashed_at") @db.Timestamptz(6)
  purgeAfter DateTime? @map("purge_after") @db.Timestamptz(6)
  closedAt DateTime? @map("closed_at") @db.Timestamptz(6)
  legalHold Boolean @default(false) @map("legal_hold")
  @@unique([workspaceId, id])
  @@unique([workspaceId, typeId, itemNumber])
  @@index([workspaceId, typeId, status, assignedUserId])
  @@map("spa_items")
}

model SpaItemValue {
  id String @id @default(uuid()) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  itemId String @map("item_id") @db.Uuid
  fieldId String @map("field_id") @db.Uuid
  valueText String? @map("value_text")
  valueNumber Decimal? @map("value_number") @db.Decimal(24,6)
  valueDate DateTime? @map("value_date") @db.Timestamptz(6)
  valueBoolean Boolean? @map("value_boolean")
  valueJson Json? @map("value_json")
  schemaVersion Int @map("schema_version")
  @@unique([workspaceId, itemId, fieldId])
  @@map("spa_item_field_values")
}

model SpaItemObserver {
  id String @id @default(uuid()) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  itemId String @map("item_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  @@unique([workspaceId, itemId, userId])
  @@map("spa_item_observers")
}

model SpaHistory {
  id String @id @default(uuid()) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  typeId String @map("type_id") @db.Uuid
  itemId String? @map("item_id") @db.Uuid
  actorUserId String @map("actor_user_id") @db.Uuid
  action String
  changes Json
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  @@index([workspaceId, typeId, itemId, occurredAt])
  @@map("spa_history")
}

model SpaNumberingScheme {
  id String @id @default(uuid()) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  typeId String @map("type_id") @db.Uuid
  prefixTemplate String @map("prefix_template")
  padding Int @default(6)
  resetPolicy String @default("NEVER") @map("reset_policy")
  version Int @default(1)
  @@unique([workspaceId, typeId])
  @@map("spa_numbering_schemes")
}

model SpaNumberingSequence {
  id String @id @default(uuid()) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  typeId String @map("type_id") @db.Uuid
  periodKey String @map("period_key")
  nextValue BigInt @default(1) @map("next_value")
  @@unique([workspaceId, typeId, periodKey])
  @@map("spa_numbering_sequences")
}

model CalendarBookingNotificationEvent {
  eventId String @id @map("event_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@map("calendar_booking_notification_events")
}

model CalendarBookingNotificationDelivery {
  id String @id @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  bookingId String @map("booking_id") @db.Uuid
  eventId String @map("event_id") @db.Uuid
  sourceVersion Int @map("source_version")
  notificationType String @map("notification_type")
  recipientKey String @map("recipient_key")
  recipientUserId String? @map("recipient_user_id") @db.Uuid
  guestEmail String? @map("guest_email")
  status String
  attempts Int @default(0)
  nextAttemptAt DateTime? @map("next_attempt_at") @db.Timestamptz(6)
  claimToken String? @map("claim_token") @db.Uuid
  leaseExpiresAt DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  lastErrorCode String? @map("last_error_code")
  sentAt DateTime? @map("sent_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  @@unique([eventId, recipientKey])
  @@index([status, nextAttemptAt])
  @@map("calendar_booking_notification_deliveries")
}

model ProjectFileStorage {
  id String @id @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  type String
  ownerUserId String? @map("owner_user_id") @db.Uuid
  projectId String? @unique @map("project_id") @db.Uuid
  name String
  isActive Boolean @map("is_active")
  isReadOnly Boolean @map("is_read_only")
  version Int @default(1)
  createdAt DateTime @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @map("updated_at") @db.Timestamptz(6)
  @@unique([workspaceId, id])
  @@map("file_storages")
}

model ProjectRootFolder {
  id String @id @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  storageId String @map("storage_id") @db.Uuid
  parentFolderId String? @map("parent_folder_id") @db.Uuid
  name String
  status String
  originalParentFolderId String? @map("original_parent_folder_id") @db.Uuid
  trashedAt DateTime? @map("trashed_at") @db.Timestamptz(6)
  purgeAfter DateTime? @map("purge_after") @db.Timestamptz(6)
  publicShareVersion Int @default(1) @map("public_share_version")
  version Int @default(1)
  createdAt DateTime @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @map("updated_at") @db.Timestamptz(6)
  @@unique([workspaceId, id])
  @@map("file_folders")
}

model StorageAccessSource {
  id String @id @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  storageId String @map("storage_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  sourceType String @map("source_type")
  sourceId String @map("source_id") @db.Uuid
  permissionLevel String @map("permission_level")
  active Boolean
  createdAt DateTime @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @map("updated_at") @db.Timestamptz(6)
  @@unique([storageId, userId, sourceType, sourceId])
  @@map("storage_access_sources")
}

model CollaborationChat {
  id String @id @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  type String
  title String?
  linkedTaskId String? @unique @map("linked_task_id") @db.Uuid
  linkedProjectId String? @unique @map("linked_project_id") @db.Uuid
  linkedDepartmentId String? @unique @map("linked_department_id") @db.Uuid
  linkedCollabId String? @unique @map("linked_collab_id") @db.Uuid
  createdByUserId String @map("created_by_user_id") @db.Uuid
  status String
  version Int @default(1)
  createdAt DateTime @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @map("updated_at") @db.Timestamptz(6)
  @@unique([workspaceId, id])
  @@map("collaboration_chats")
}

model CollabSpace {
  id String @id @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  name String
  ownerUserId String @map("owner_user_id") @db.Uuid
  status String
  version Int @default(1)
  description String?
  createdByUserId String? @map("created_by_user_id") @db.Uuid
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  @@unique([workspaceId, id])
  @@map("collab_spaces")
}

model CollabSpaceMember {
  id String @id @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  collabId String @map("collab_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  memberType String @map("member_type")
  role String
  status String
  joinedAt DateTime? @map("joined_at") @db.Timestamptz(6)
  leftAt DateTime? @map("left_at") @db.Timestamptz(6)
  @@unique([collabId, userId])
  @@map("collab_space_members")
}

model DirectChatPair {
  id String @id @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  chatId String @unique @map("chat_id") @db.Uuid
  userAId String @map("user_a_id") @db.Uuid
  userBId String @map("user_b_id") @db.Uuid
  @@unique([workspaceId, userAId, userBId])
  @@map("direct_chat_pairs")
}

model FilePublicLink {
  id String @id @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  resourceType String @map("resource_type")
  resourceId String @map("resource_id") @db.Uuid
  tokenHash String @unique @map("token_hash")
  permissionMode String @map("permission_mode")
  passwordHash String? @map("password_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  maxDownloads Int? @map("max_downloads")
  downloadCount Int @default(0) @map("download_count")
  accessCount Int @default(0) @map("access_count")
  includeChildren Boolean @map("include_children")
  isActive Boolean @map("is_active")
  createdByUserId String @map("created_by_user_id") @db.Uuid
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  resourceShareVersion Int @map("resource_share_version")
  version Int @default(1)
  createdAt DateTime @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @map("updated_at") @db.Timestamptz(6)
  @@index([workspaceId, resourceType, resourceId])
  @@map("file_public_links")
}

model DriveFile {
  id String @id @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  storageId String @map("storage_id") @db.Uuid
  folderId String @map("folder_id") @db.Uuid
  name String
  extension String
  mimeType String @map("mime_type")
  currentVersionId String? @map("current_version_id") @db.Uuid
  status String
  sizeBytesCurrent Float @map("size_bytes_current")
  version Int @default(1)
  trashedAt DateTime? @map("trashed_at") @db.Timestamptz(6)
  purgeAfter DateTime? @map("purge_after") @db.Timestamptz(6)
  originalFolderId String? @map("original_folder_id") @db.Uuid
  statusBeforeTrash String? @map("status_before_trash")
  publicShareVersion Int @default(1) @map("public_share_version")
  createdAt DateTime @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @map("updated_at") @db.Timestamptz(6)
  @@unique([workspaceId, id])
  @@index([workspaceId, storageId, folderId])
  @@map("drive_files")
}

model DriveFileVersion {
  id String @id @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  fileId String @map("file_id") @db.Uuid
  versionNumber Int @map("version_number")
  objectKey String @map("object_key")
  sizeBytes Float @map("size_bytes")
  checksum String
  mimeType String @map("mime_type")
  createdByUserId String @map("created_by_user_id") @db.Uuid
  createdAt DateTime @map("created_at") @db.Timestamptz(6)
  scanStatus String @map("scan_status")
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)
  @@unique([fileId, versionNumber])
  @@unique([workspaceId, fileId, id])
  @@map("drive_file_versions")
}

model FilePermissionAssignment {
  id String @id @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  resourceType String @map("resource_type")
  resourceId String @map("resource_id") @db.Uuid
  subjectType String @map("subject_type")
  subjectId String? @map("subject_id")
  permissionLevel String @map("permission_level")
  inheritanceMode String @map("inheritance_mode")
  @@index([workspaceId, resourceType, resourceId])
  @@map("file_permission_assignments")
}

model CollaborationChatMember {
  id String @id @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  chatId String @map("chat_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  role String
  joinedAt DateTime @map("joined_at") @db.Timestamptz(6)
  leftAt DateTime? @map("left_at") @db.Timestamptz(6)
  @@unique([chatId, userId])
  lastReadMessageId String? @map("last_read_message_id") @db.Uuid
  @@map("collaboration_chat_members")
}

model CollaborationChatMembershipSource {
  id String @id @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  chatId String @map("chat_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  sourceType String @map("source_type")
  sourceId String @map("source_id") @db.Uuid
  active Boolean
  createdAt DateTime @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @map("updated_at") @db.Timestamptz(6)
  @@unique([chatId, userId, sourceType, sourceId])
  @@map("collaboration_chat_membership_sources")
}

model UserNotification {
  id               String   @id @default(uuid()) @db.Uuid
  workspaceId      String   @map("workspace_id") @db.Uuid
  recipientUserId  String   @map("recipient_user_id") @db.Uuid
  notificationType String   @map("notification_type")
  title            String
  message          String
  link             String?
  idempotencyKey   String   @map("idempotency_key")
  readAt           DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([workspaceId, recipientUserId, idempotencyKey])
  @@index([workspaceId, recipientUserId, createdAt])
  @@map("user_notifications")
}

model NotificationPreference {
  id               String  @id @default(uuid()) @db.Uuid
  workspaceId      String  @map("workspace_id") @db.Uuid
  userId           String  @map("user_id") @db.Uuid
  notificationType String  @map("notification_type")
  channel          String
  enabled          Boolean @default(true)

  @@unique([workspaceId, userId, notificationType, channel])
  @@map("notification_preferences")
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  REVOKED
  EXPIRED
}

enum PermissionScope {
  OWN
  DEPARTMENT
  DEPARTMENT_TREE
  WORKSPACE
}

enum PartnerApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PartnerStatus {
  ACTIVE
  SUSPENDED
}

enum CrmPipelineEntityType {
  LEAD
  DEAL
}

enum CrmRecordEntityType {
  LEAD
  DEAL
  CONTACT
  COMPANY
}

enum CrmStageSemanticType {
  PROGRESS
  SUCCESS
  FAILURE
}

enum CrmLeadStatus {
  ACTIVE
  QUALIFIED
  DISQUALIFIED
}

enum CrmLeadConversionStatus {
  NOT_CONVERTED
  CONVERTED
}

enum CrmDealStatus {
  OPEN
  WON
  LOST
}

enum CrmCommunicationType {
  PHONE
  EMAIL
  WEB
  IM
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  firstName       String     @map("first_name")
  lastName        String     @map("last_name")
  email           String     @unique
  settings        Json       @default("{}")
  meta            Json?
  status          UserStatus
  emailVerifiedAt DateTime?  @map("email_verified_at")
  isDeleted       Boolean    @default(false) @map("is_deleted")

  authIdentities          AuthIdentity[]
  refreshSessions         RefreshSession[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  workspaceMemberships    WorkspaceMembership[]
  ownedWorkspaces         Workspace[]              @relation("WorkspaceOwner")
  departmentMemberships   DepartmentMember[]
  managedDepartments      Department[]             @relation("DepartmentManager")
  auditLogs               AuditLog[]               @relation("AuditActor")
  sentInvitations         WorkspaceInvitation[]    @relation("InvitationInviter")
  partnerMemberships      PartnerMembership[]
  partnerApplications     PartnerApplication[]
  ownedCalendars          Calendar[]               @relation("CalendarOwner")
  createdCalendars        Calendar[]               @relation("CalendarCreator")
  calendarPreferences     UserCalendarPreference[]
  organizedCalendarEvents CalendarEvent[]
  calendarEventAttendance CalendarEventAttendee[]

  @@map("users")
}

model AuthIdentity {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  provider       AuthProvider
  providerUserId String?      @map("provider_user_id")
  passwordHash   String?      @map("password_hash")
  isDeleted      Boolean      @default(false) @map("is_deleted")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
  @@map("auth_identities")
}

model RefreshSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  isDeleted Boolean   @default(false) @map("is_deleted")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_sessions")
}

model EmailVerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  isDeleted  Boolean   @default(false) @map("is_deleted")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  isDeleted  Boolean   @default(false) @map("is_deleted")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model Workspace {
  id               String                     @id @default(uuid()) @db.Uuid
  name             String
  slug             String                     @unique
  description      String?
  settings         Json                       @default("{}")
  meta             Json?
  ownerUserId      String                     @map("owner_user_id") @db.Uuid
  isDeleted        Boolean                    @default(false) @map("is_deleted")
  owner            User                       @relation("WorkspaceOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  memberships      WorkspaceMembership[]
  roles            Role[]
  departments      Department[]
  invitations      WorkspaceInvitation[]
  auditLogs        AuditLog[]
  partnerRelations PartnerWorkspaceRelation[]
  projects         Project[]
  tasks            Task[]
  taskTemplates    TaskTemplate[]
  calendars        Calendar[]

  @@map("workspaces")
}

model WorkspaceMembership {

{
  "name": "entertabcrm-be",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start:process-platform": "node --env-file-if-exists=.env --import tsx src/server/process-platform/main.ts",
    "worker:process-platform": "node --env-file-if-exists=.env --import tsx src/server/process-platform/workers.ts",
    "predev": "npm run db:setup",
    "dev": "next dev -p 3001",
    "start": "next start -p 3001",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run db:start",
    "test": "jest --config jest.config.ts --runInBand",
    "test:endpoints": "npm run db:start && jest --config jest.config.ts --runInBand tests/api-endpoints.spec.ts",
    "test:endpoints:live": "npm run db:start && node Script/Testing/run-live-endpoints.js",
    "test:all": "npm run typecheck && npm run prisma:validate && npm test && npm run test:endpoints:live && npm run build",
    "db:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File Script/Database/LocalPostgres.ps1 setup",
    "db:start": "powershell -NoProfile -ExecutionPolicy Bypass -File Script/Database/LocalPostgres.ps1 start",
    "db:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File Script/Database/LocalPostgres.ps1 stop",
    "db:health": "powershell -NoProfile -ExecutionPolicy Bypass -File Script/Database/LocalPostgres.ps1 health",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:format": "prisma format",
    "seed:admin": "node Script/Seeding/SeedAdmin.js",
    "seed:permissions": "node Script/Seeding/SeedPermissions.js",
    "seed:admin-permissions": "node Script/Seeding/SeedAdminPermissions.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@prisma/client": "^6.16.2",
    "@types/jsonwebtoken": "^9.0.10",
    "argon2": "^0.44.0",
    "jose": "^6.1.0",
    "jsonwebtoken": "^9.0.3",
    "next": "^15.5.4",
    "reflect-metadata": "^0.2.2",
    "rrule": "^2.8.1",
    "rxjs": "^7.8.2",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.5.2",
    "@types/react": "19.3.0",
    "jest": "^30.1.3",
    "prisma": "^6.16.2",
    "ts-jest": "^29.4.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2"
  }
}

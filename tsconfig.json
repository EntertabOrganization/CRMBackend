{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "es2022"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    ".next-dev/types/**/*.ts",
    ".next-live/types/**/*.ts",
    ".next/types/**/*.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/client/**/*.ts",
    "src/client/**/*.tsx",
    "next-env.d.ts",
    "src/server/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "src/modules",
    "tests/auth-api.e2e-spec.ts",
    "tests/auth-module.spec.ts",
    "tests/modules/TrueCRM_Final_Modules_Codex_Pack/_harness/test-globals.d.ts"
  ]
}

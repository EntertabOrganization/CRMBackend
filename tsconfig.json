{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "es2022"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    ".next/types/**/*.ts",
    "Commercial_Capture_ContactCenter/Testing/**/*.ts",
    "Data_Integration_Intelligence_Analytics/Testing/**/*.ts",
    "Tasks&Calendar&Files&Chats/Testing/support/**/*.ts",
    "Tasks&Calendar&Files&Chats/Testing/Tasks-Projects/**/*.ts",
    "Tasks&Calendar&Files&Chats/Testing/Calendar-Meetings/calendars.spec.ts",
    "Tasks&Calendar&Files&Chats/Testing/Calendar-Meetings/calendars.e2e-spec.ts",
    "Tasks&Calendar&Files&Chats/Testing/Calendar-Meetings/events-meetings.spec.ts",
    "Tasks&Calendar&Files&Chats/Testing/Calendar-Meetings/events-meetings.e2e-spec.ts",
    "Tasks&Calendar&Files&Chats/Testing/Calendar-Meetings/recurrence-engine.spec.ts",
    "Tasks&Calendar&Files&Chats/Testing/Calendar-Meetings/recurrence-series.spec.ts",
    "Tasks&Calendar&Files&Chats/Testing/Calendar-Meetings/recurrence-series.e2e-spec.ts",
    "app/**/*.ts",
    "next-env.d.ts",
    "src/server/**/*.ts",
    "tests/**/*.ts",
    ".next-dev/types/**/*.ts",
    ".next-live/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "Auth_Module",
    "CRM_Core_Pipelines",
    "src/modules",
    "tests/auth-api.e2e-spec.ts",
    "tests/auth-module.spec.ts"
  ]
}
